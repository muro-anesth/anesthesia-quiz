rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // Existing muro account. Roles and usernames cannot grant administrator access.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'kuredXmbTWhCfx4dVtvdUyiZsUq1';
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isAdmin();
      // Profiles are managed only by the Admin SDK.
      allow write: if false;
    }
    match /users/{userId}/{collectionName}/{documentId} {
      allow read, write: if isOwner(userId) &&
        collectionName in ['attempts', 'progress', 'examHistory'];
    }
    match /questions/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /users/{userId}/questionStars/{questionId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['questionId', 'starred', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['questionId', 'starred', 'updatedAt'])
        && request.resource.data.questionId == questionId
        && request.resource.data.starred is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
