generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id           Int      @id @default(autoincrement())
  qnum         Int
  year         String
  category     String   @default("未分類")
  stem         String   @db.Text
  choiceA      String   @default("") @db.Text
  choiceB      String   @default("") @db.Text
  choiceC      String   @default("") @db.Text
  choiceD      String   @default("") @db.Text
  choiceE      String   @default("") @db.Text
  answer       String   // "c" or "ac" for X2
  questionType String   @default("single") // single | combination | image_answers | image_only | x2
  hasImage     Boolean  @default(false)
  mainImage    String?  // e.g. "q21.png"
  optionImages String   @default("[]") // JSON array
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())

  attempts    Attempt[]
  srsCards    SrsCard[]
  explanation Explanation?

  @@unique([year, qnum])
  @@index([year])
  @@index([deleted])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  password      String?   // ← 追加
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  attempts Attempt[]
  srsCards SrsCard[]
}

model Attempt {
  id         Int      @id @default(autoincrement())
  userId     String
  questionId Int
  selected   String   // "c" or "ac"
  isCorrect  Boolean
  answeredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

// FSRS state per user per question
model SrsCard {
  id            Int       @id @default(autoincrement())
  userId        String
  questionId    Int
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0=New 1=Learning 2=Review 3=Relearning
  lastReview    DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, due])
}

model Explanation {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  body       String   @db.Text
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---- Auth.js required models ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
